<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean class="pojo.Address" id="addr" autowire-candidate="true">
        <constructor-arg value="101"/>
        <constructor-arg value="201"/>
        <constructor-arg value="lalachauk"/>
    </bean>
    <bean class="pojo.Address" id="addr1" autowire-candidate="false">
        <constructor-arg value="102"/>
        <constructor-arg value="202"/>
        <constructor-arg value="sanjay_nagar"/>
    </bean>

    <bean class="pojo.Student" id="std1" autowire="byType">// one more type   autowire = "byContructor"
        <property name="id" value="102"/>
        <property name="name" value="shreya"/>
        <property name="email" value="shreya@gmail.com"/>
        <!-- // by name injection... replace of autowired = "byName"-->
    </bean>

</beans>