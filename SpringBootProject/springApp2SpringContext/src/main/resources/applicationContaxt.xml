<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="pojo.Student" id="std1">
        <property name="id" value="101"/>
        <property name="name" value="ankush"/>
        <property name="email" value="ankush@gmail.com"/>
    </bean>
    <bean class="pojo.Student" id="std2">
        <property name="id" value="102"/>
        <property name="name" value="shreya"/>
        <property name="email" value="shreya@gmail.com"/>

    </bean>

</beans>